{
  "name": "@alanrodas/zxdo",
  "version": "0.1.0",
  "description": "A simple task runner built around Google's ZX",
  "repository": "https://github.com/alanrodas/zxdo",
  "license": "MIT",
  "author": "Alan Rodas Bonjour <alanrodas@gmail.com>",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "zxdo": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "doc": "typedoc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --unsafe --write ."
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "fs-extra": "^11.2.0",
    "zx": "^8.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.9",
    "@vitest/coverage-v8": "^1.6.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
